# Public client values, copied from claude-built-apps platform/supabase.json (public by design:
# the anon key only reaches rows that row level security allows). Vite reads VITE_* at build
# time; on Netlify, netlify.toml at the repository root sets them. Leave them empty for the
# preview (fixture data, fake sign-in, the functions' fakes).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The analysis service on Render (udebt.hosted.worker_service), e.g. https://udebt-api.hintwise.org
VITE_UDEBT_WORKER_URL=

# Read by the Netlify functions at run time (set on the Netlify site, not in netlify.toml):
# SUPABASE_URL=https://auth.hintwise.org
# SUPABASE_ANON_KEY=<the same public anon key>
# Preview only: a local clone the fake GitHub reads excerpts from, as JSON {"owner/repo": "/path"}.
# UDEBT_FAKE_REPOS={"pisanuw/digitalme": "/path/to/digitalme"}
